# ---- Telegram ----
BOT_TOKEN=123456:ABC...
# Short name you gave the Mini App in @BotFather (/newapp). Link becomes t.me/<bot>/<APP_SHORT_NAME>
APP_SHORT_NAME=vc
# Your Railway public URL (also set as the Mini App URL in BotFather)
PUBLIC_URL=https://your-app.up.railway.app
# Any long random string. Changing it invalidates every group link.
SECRET_KEY=change-me-to-a-long-random-string

# ---- LiveKit (voice/video) ----
LIVEKIT_URL=wss://your-livekit.up.railway.app
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: private network URL for server calls, e.g. http://livekit.railway.internal:7880
LIVEKIT_HTTP_URL=

# ---- YouTube (optional but recommended on Railway) ----
# bgutil PO token provider service (Railway private URL)
POT_PROVIDER_URL=http://bgutil-provider.railway.internal:4416
# cookies.txt from a throwaway YouTube account, base64 encoded
YT_COOKIES_B64=
AUDIO_CACHE_MB=800

# Pinned bar wording: 'Voice Chat' or 'Video Chat'
VC_LABEL=Voice Chat
FULLSCREEN=1

DATA_DIR=/data
# Local testing only. NEVER set in production.
DEV_MODE=0

# Optional: full member list for invites (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=

# 1 = the server plays the music into the voice chat (like a music bot): one way for every phone, no tap, goes on
# in the background, the same moment for everyone. Needs LiveKit. Without it, each phone plays the music itself.
MUSIC_IN_VOICE=

# Your Telegram id (send /id to the bot): you see the Health page and add sudo users who see it too
# (/addsudo with an id, an @username or as a reply; or on the Health page)
OWNER_ID=

# Optional: whole Spotify playlists (https://developer.spotify.com)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
